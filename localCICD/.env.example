COMPOSE_PROJECT_NAME=local-cloud-dev-platform
PLATFORM_HOSTNAME=localhost
LOCAL_PLATFORM_NETWORK=local-platform-network
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Git server
GITEA_IMAGE=gitea/gitea:latest
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_USER_UID=1000
GITEA_USER_GID=1000

# Gitea Actions runner
GITEA_RUNNER_IMAGE=gitea/act_runner:latest
GITEA_INSTANCE_URL=http://gitea:3000
GITEA_RUNNER_NAME=local-runner
GITEA_RUNNER_LABELS=ubuntu-latest:docker://node:20-bookworm,ubuntu-22.04:docker://node:20-bookworm
GITEA_RUNNER_REGISTRATION_TOKEN=0f9HsuFdvsBy9bkfl8OCk5uH2yMaM7bs6rHwW4Cx

# Container registry
REGISTRY_IMAGE=registry:2
REGISTRY_PORT=5000

# AWS-style services
LOCALSTACK_IMAGE=localstack/localstack:3.8.1
LOCALSTACK_PORT=4566
LOCALSTACK_SERVICES=s3,sqs,sns,dynamodb,iam,sts
LOCALSTACK_DEBUG=0
LOCALSTACK_PERSISTENCE=1
AWS_DEFAULT_REGION=us-east-1

# Azure Storage emulator
AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:latest
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002

# GCP Storage emulator
FAKE_GCS_IMAGE=fsouza/fake-gcs-server:latest
FAKE_GCS_PORT=4443

# SonarQube
SONARQUBE_IMAGE=sonarqube:community
SONARQUBE_PORT=9000
SONAR_POSTGRES_IMAGE=postgres:16-alpine
SONAR_POSTGRES_DB=sonarqube
SONAR_POSTGRES_USER=sonarqube
SONAR_POSTGRES_PASSWORD=sonarqube
SONAR_Admin=Admin
SONAR_Admin_PWD=Zanokuhl@2020!!!

# Stable local endpoints
GITEA_URL=http://localhost:3000
GITEA_SSH=ssh://git@localhost:2222
REGISTRY_URL=http://localhost:5000
LOCALSTACK_URL=http://localhost:4566
AZURITE_BLOB_URL=http://localhost:10000
AZURITE_QUEUE_URL=http://localhost:10001
AZURITE_TABLE_URL=http://localhost:10002
FAKE_GCS_URL=http://localhost:4443
SONARQUBE_URL=http://localhost:9000

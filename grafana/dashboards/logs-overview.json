{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({level=\"ERROR\"}[5m]))"
        }
      ],
      "title": "Error Logs By Service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({level=\"WARN\"}[5m]))"
        }
      ],
      "title": "Warning Logs By Service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} |~ \"$search\""
        }
      ],
      "title": "Logs By Service, Trace ID, Correlation ID, Or Path",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 40,
  "tags": ["local-observability", "logs"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": ".*", "value": ".*" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(service_name)",
        "label": "Service",
        "name": "service",
        "query": "label_values(service_name)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "selected": false, "text": ".*", "value": ".*" },
        "label": "Search",
        "name": "search",
        "query": ".*",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Logs Overview",
  "uid": "logs-overview",
  "version": 2
}
